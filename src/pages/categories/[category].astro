---
import type { GetStaticPaths } from 'astro';
import BaseLayout from '@/layouts/BaseLayout.astro';
import PostList from '@/components/PostList.astro';
import { getCategoryGroups } from '@/lib/posts';

export const getStaticPaths = (async () => {
  const groups = await getCategoryGroups();
  return groups.map((group) => ({ params: { category: group.slug }, props: { group } }));
}) satisfies GetStaticPaths;

const { group } = Astro.props;
---

<BaseLayout title={`카테고리: ${group.name}`} crumbs={['카테고리', group.name]}>
  <h1 class="page-title">{group.name} <span class="muted">{group.posts.length}</span></h1>
  <PostList posts={group.posts} />
</BaseLayout>
