---
import BaseLayout from '@/layouts/BaseLayout.astro';
import { getTagGroups } from '@/lib/posts';
import { tagUrl } from '@/lib/url';

const groups = await getTagGroups();
---

<BaseLayout title="태그" crumbs={['태그']}>
  <h1 class="page-title">태그</h1>
  <ul class="cloud">
    {
      groups.map((group) => (
        <li>
          <a class="chip" href={tagUrl(group.name)}>
            {group.name} <span class="muted">{group.posts.length}</span>
          </a>
        </li>
      ))
    }
  </ul>
</BaseLayout>

<style>
  .cloud {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin: 0;
    padding: 0;
    list-style: none;
  }
</style>
