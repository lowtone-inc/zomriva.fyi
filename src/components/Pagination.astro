---
import { withBase } from '@/lib/url';

export interface Props {
  current: number;
  total: number;
}

const { current, total } = Astro.props;
// Chirpy 규칙: 1페이지는 /, 그 외는 /page2/
const href = (n: number) => withBase(n === 1 ? '/' : `/page${n}/`);
const pages = Array.from({ length: total }, (_, i) => i + 1);
---

{
  total > 1 && (
    <nav class="pagination" aria-label="페이지">
      {current > 1 && <a href={href(current - 1)}>&lsaquo;</a>}
      {pages.map((n) => (
        <a href={href(n)} class:list={{ active: n === current }} aria-current={n === current ? 'page' : undefined}>
          {n}
        </a>
      ))}
      {current < total && <a href={href(current + 1)}>&rsaquo;</a>}
    </nav>
  )
}

<style>
  .pagination {
    display: flex;
    justify-content: center;
    gap: 6px;
    margin-top: 32px;
  }
  a {
    min-width: 36px;
    padding: 4px 10px;
    border-radius: var(--radius);
    text-align: center;
  }
  a:hover {
    background: var(--c-card-hover);
  }
  a.active {
    background: var(--c-accent);
    color: #000;
    font-weight: 700;
  }
</style>
