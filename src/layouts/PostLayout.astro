---
import BaseLayout from './BaseLayout.astro';
import PostNav from '@/components/PostNav.astro';
import TagList from '@/components/TagList.astro';
import Toc from '@/components/Toc.astro';
import { formatDate, isoDate, readingTime } from '@/lib/format';
import { categoryUrl } from '@/lib/url';
import type { MarkdownHeading } from 'astro';
import type { Post } from '@/lib/posts';

export interface Props {
  post: Post;
  headings: MarkdownHeading[];
  newer?: Post;
  older?: Post;
}

const { post, headings, newer, older } = Astro.props;
const { title, description, tags, category, pubDate, updatedDate } = post.data;
---

<BaseLayout
  title={title}
  description={description}
  article={{ publishedTime: pubDate, modifiedTime: updatedDate, tags }}
  crumbs={[category, title]}
>
  <article>
    <h1>{title}</h1>
    <p class="meta">
      <a href={categoryUrl(category)} class="cat">{category}</a>
      <time datetime={isoDate(pubDate)}>{formatDate(pubDate)}</time>
      {updatedDate && <span>(수정 {formatDate(updatedDate)})</span>}
      <span>· {readingTime(post.body)} 읽기</span>
    </p>
    <div class="prose">
      <slot />
    </div>
    {tags.length > 0 && <div class="tags"><TagList tags={tags} /></div>}
    <PostNav newer={newer} older={older} />
  </article>
  <Toc slot="aside" headings={headings} />
</BaseLayout>

<style>
  h1 {
    margin: 0 0 12px;
    font-size: clamp(1.6rem, 4vw, 2.2rem);
    font-weight: 900;
  }
  .meta {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin: 0 0 32px;
    color: var(--c-muted);
    font-size: 0.85rem;
  }
  .cat {
    color: var(--c-accent);
    font-weight: 700;
  }
  .tags {
    margin-top: 40px;
  }
</style>
